PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="your-jwt-secret"

# --- Production Deployment ---
# FRONTEND_URL: Set on Render to your Vercel URL (e.g. https://preptalk.vercel.app)
FRONTEND_URL="https://your-vercel-url.vercel.app"

# VITE_API_URL: Set on Vercel to your Render backend URL (no trailing slash)
VITE_API_URL="https://preptalk-api.onrender.com"

# Groq Cloud API (groq.com)
GROQ_API_KEY="your-groq-api-key"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
GROQ_MODEL="llama-3.3-70b-versatile"

# xAI Grok API (x.ai)
GROK_API_KEY="your-grok-api-key"
GROK_API_URL="https://api.x.ai/v1/chat/completions"
GROK_MODEL="grok-beta"

NODE_ENV="development"
