{
  "name": "preptrack-server",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/index.js",

  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:seed": "ts-node ../prisma/seed.ts",
    "postinstall": "npx prisma generate"
  }
}
